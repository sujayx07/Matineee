# Server
PORT=3001
NODE_ENV=production
# SQLite file for room persistence. "off" = memory only.
DATABASE_PATH=./data/watchparty.db
# Only needed when the client is hosted on a different origin (e.g. Netlify/Vercel)
CORS_ORIGINS=
MAX_PARTICIPANTS_PER_ROOM=50
RECONNECT_GRACE_MS=20000
REQUEST_TTL_MS=60000

# Client (build time) — only for split deployments
VITE_SERVER_URL=
